PORT=3000
FRONTEND_URL=https://tataiya.in
API_URL=https://tataiya.in/api

# Deep Linking / Share settings
APP_PACKAGE_NAME=com.xoto.app
APP_SCHEME=xoto
APP_STORE_ID=123456789

# MongoDB Connection (Atlas)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tataiya?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.egm8g2u.mongodb.net/tataiya?retryWrites=true&w=majority&appName=Cluster0

# Redis Connection
REDIS_URI=redis://localhost:6379

# Storage driver: local | s3  (default s3 when credentials are set)
STORAGE_DRIVER=s3

# AWS S3 Configuration
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=tataiya-ott
AWS_S3_REGION=us-east-1
# Optional CloudFront / custom CDN base (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Video transcoder: auto (MediaConvert if role set, else local ffmpeg) | aws | local
VIDEO_TRANSCODER=auto
# AWS Elemental MediaConvert (optional — same-quality ABR HLS with QVBR, less space)
# Create an IAM role that MediaConvert can assume with S3 read/write on your bucket.
# AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/MediaConvert_Default_Role
# AWS_MEDIACONVERT_QUEUE=arn:aws:mediaconvert:REGION:ACCOUNT_ID:queues/Default
# AWS_MEDIACONVERT_ENDPOINT=https://xxxxx.mediaconvert.REGION.amazonaws.com

# Message Central OTP — prefer Admin → Settings → Message Central (OTP)
# Keys are stored in DB Settings; env fallbacks are optional.
# MESSAGE_CENTRAL_CUSTOMER_ID=
# MESSAGE_CENTRAL_EMAIL=
# MESSAGE_CENTRAL_PASSWORD=
