              ],
              "path": [
                "api",
                "app",
                "auth",
                "send-otp"
              ]
            },
            "description": "Send 4-digit OTP to mobile number",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
